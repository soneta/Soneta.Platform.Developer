{
  "$schema": "http://json.schemastore.org/template",
  "author": "Soneta",
  "classifications": [ "Soneta", "Addon", "Item", "ViewInfo" ],
  "identity": "Soneta.Addon.Item.ViewInfo",
  "groupIdentity": "Soneta.Addon.Item.ViewInfo",
  "name": "Soneta Addon Item ViewInfo",
  "shortName": "soneta-item-viewinfo",
  "description": "Komponent ViewInfo dla produktów firmy Soneta",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "preferNameDirectory": false,
  "symbols": {
    "default-namespace": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "replaces": "%NAMESPACE%",
      "description": "Przestrzeń nazw dla widoku",
      "msbuild": "RootNamespace"
    },
    "viewinfo-name": {
      "type": "parameter",
      "dataType": "string",
      "description": "Nazwa tworzonej klasy dla tworzonego widoku"
    },
    "computed-name": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "viewinfo-name",
        "fallbackVariableName": "default-namespace"
      }
    },
    "safe-computed-name": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "computed-name",
        "steps": [
          {
            "regex": "^(.*?)\\..*",
            "replacement": "$1"
          }
        ]
      },
      "replaces": "%VIEWINFONAME%",
      "fileRename": "Page"
    },
    "viewinfo-class": {
      "type": "generated",
      "generator": "join",
      "replaces": "%VIEWINFOCLASS%",
      "fileRename": "Class",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "safe-computed-name"
          },
          {
            "type": "const",
            "value": "ViewInfo"
          }
        ],
        "separator": "",
        "removeEmptyValues": true
      }
    },
    "viewinfo-tablename": {
      "type": "parameter",
      "replaces": "%VIEWINFOTABLENAME%",
      "dataType": "string",
      "description": "Nazwa tabeli (Table)",
      "defaultValue": "Soneta.Towary.Towary"
    },
    "viewinfo-description": {
      "type": "parameter",
      "replaces": "%VIEWINFODESCRYPTION%",
      "dataType": "string",
      "description": "Opis (Description)",
      "defaultValue": ""
    },
    "viewinfo-priority": {
      "type": "parameter",
      "replaces": "%VIEWINFOPRIORITY%",
      "dataType": "string",
      "description": "Priorytet (Priority)",
      "defaultValue": "100000"
    }
  },
  "sources": [
    {
      "include": [ "*.cs", "*.xml" ]
    }
  ]
}
