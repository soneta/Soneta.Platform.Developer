{
  "$schema": "http://json.schemastore.org/template",
  "author": "Soneta",
  "classifications": [ "Soneta", "Addon", "Item", "BusinessXml" ],
  "identity": "Soneta.Addon.Item.BusinessXml",
  "groupIdentity": "Soneta.Addon.Item.BusinessXml",
  "name": "Soneta Addon Item BusinessXml",
  "shortName": "soneta-item-businessxml",
  "description": "Rozszerzenie bazy danych dla produktów firmy Soneta",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "preferNameDirectory": false,
  "symbols": {
    "default-namespace": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "replaces": "%NAMESPACE%",
      "description": "Przestrzeń nazw dla workera",
      "msbuild": "RootNamespace"
    },
    "module-name": {
      "type": "parameter",
      "dataType": "string",
      "description": "Własna nazwa tworzonego modułu"
    },
    "computed-name": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "module-name",
        "fallbackVariableName": "default-namespace"
      }
    },
    "safe-computed-name": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "computed-name",
        "steps": [
          {
            "regex": "^(.*?)\\..*",
            "replacement": "$1"
          }
        ]
      },
      "replaces": "%MODULENAME%",
      "fileRename": "file"
    }
  },
  "sources": [
    {
      "include": [ "*.xml" ]
    }
  ]
}
