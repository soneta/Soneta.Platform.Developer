<?xml version="1.0" encoding="utf-8" ?>
<DataForm xmlns:xsd="http://www.w3.org/2001/XMLSchema"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://www.enova.pl/schema/form.xsd"
          xsi:schemaLocation="http://www.enova.pl/schema/ http://www.enova.pl/schema/form.xsd"
          DataType="Soneta.Business.UI.Dashboard,Soneta.Business"
          Contexts="License.All"
          Priority="%DASHBOARDPRIORITY%">
  <Page DataContext="{DataSource}" Width="2" Height="2" Visibility="{new %DASHBOARDCLASS%.IsVisible}">
    <Group CaptionHtml="%DASHBOARDCAPTION%" DataContext="{new %DASHBOARDCLASS%}" Class="DashboardItem">
      <Row>
        <Stack Width="*" Class="Tight">
          <Label CaptionHtml="Hello !!!" Class="LargeFont" Width="35"></Label>
          <Label CaptionHtml="%DASHBOARDCLASS%" Class="GreenFont" Width="35"></Label>
        </Stack>
      </Row>
    </Group>
  </Page>
</DataForm>
