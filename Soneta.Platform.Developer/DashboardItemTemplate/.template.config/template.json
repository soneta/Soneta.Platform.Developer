{
  "$schema": "http://json.schemastore.org/template",
  "author": "Soneta",
  "classifications": [ "Soneta", "Addon", "Item", "Dashboard" ],
  "identity": "Soneta.Addon.Item.Dashboard",
  "groupIdentity": "Soneta.Addon.Item.Dashboard",
  "name": "Soneta Addon Item Dashboard",
  "shortName": "soneta-item-dashboard",
  "description": "Komponent Dashboard dla produktów firmy Soneta",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "preferNameDirectory": false,
  "symbols": {
    "default-namespace": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "replaces": "%NAMESPACE%",
      "description": "Przestrzeń nazw dla klasy dashboardu",
      "msbuild": "RootNamespace"
    },
    "extender-name": {
      "type": "parameter",
      "dataType": "string",
      "description": "Własna nazwa tworzonego extendera dla dashboard"
    },
    "computed-name": {
      "type": "generated",
      "generator": "coalesce",
      "replaces": "%MODULENAME%",
      "fileRename": "file",
      "parameters": {
        "sourceVariableName": "extender-name",
        "fallbackVariableName": "default-namespace"
      }
    },
    "safe-computed-name": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "computed-name",
        "steps": [
          {
            "regex": "^(.*?)\\..*",
            "replacement": "$1"
          }
        ]
      },
      "replaces": "%MODULENAME%",
      "fileRename": "file"
    },
    "dashboard-class": {
      "type": "generated",
      "generator": "join",
      "replaces": "%DASHBOARDCLASS%",
      "fileRename": "Class",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "safe-computed-name"
          },
          {
            "type": "const",
            "value": "Extender"
          }
        ],
        "separator": "",
        "removeEmptyValues": true
      }
    },
    "dashboard-caption": {
      "type": "parameter",
      "replaces": "%DASHBOARDCAPTION%",
      "dataType": "string",
      "defaultValue": "MyDashboard",
      "description": "Tytuł dashboard (CaptionHtml)"
    },
    "dashboard-priority": {
      "type": "parameter",
      "replaces": "%DASHBOARDPRIORITY%",
      "dataType": "string",
      "description": "Priorytet (Priority)",
      "defaultValue": "100000"
    }
  },
  "sources": [
    {
      "include": [ "*.cs", "*.xml" ]
    }
  ]
}
