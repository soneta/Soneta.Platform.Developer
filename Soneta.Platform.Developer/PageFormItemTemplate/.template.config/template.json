{
  "$schema": "http://json.schemastore.org/template",
  "author": "Soneta",
  "classifications": [ "Soneta", "Addon", "Item", "PageForm" ],
  "identity": "Soneta.Addon.Item.PageForm",
  "groupIdentity": "Soneta.Addon.Item.PageForm",
  "name": "Soneta Addon Item PageForm",
  "shortName": "soneta-item-pageform",
  "description": "Komponent PageForm dla produktów firmy Soneta",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "preferNameDirectory": false,
  "symbols": {
    "default-namespace": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "replaces": "%NAMESPACE%",
      "description": "Przestrzeń nazw dla workera",
      "msbuild": "RootNamespace"
    },
    "class-name": {
      "type": "parameter",
      "dataType": "string",
      "description": "Nazwa tworzonej klasy, której zakladke wyswietlamy"
    },
    "computed-name": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "class-name",
        "fallbackVariableName": "default-namespace"
      }
    },
    "safe-computed-name": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "computed-name",
        "steps": [
          {
            "regex": "^(.*?)\\..*",
            "replacement": "$1"
          }
        ]
      }
    },
    "default-class": {
      "type": "generated",
      "generator": "join",
      "replaces": "%CLASSNAME%",
      "fileRename": "Class",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "safe-computed-name"
          },
          {
            "type": "const",
            "value": "Class"
          }
        ],
        "separator": "",
        "removeEmptyValues": true
      }
    },
    "pageform-register-folder": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Rejestruj jako folder"
    },
    "pageform-caption": {
      "type": "parameter",
      "replaces": "%PAGEFORMCAPTION%",
      "dataType": "string",
      "defaultValue": "MyPage",
      "description": "Tytuł zakładki (Caption Html)"
    },
    "pageform-pagename": {
      "type": "parameter",
      "replaces": "%PAGEFORMPAGENAME%",
      "dataType": "string",
      "description": "Nazwa zakładki (Name)",
      "fileRename": "Ogolne",
      "defaultValue": "Ogolne"
    },
    "pageform-priority": {
      "type": "parameter",
      "replaces": "%PAGEFORMPRIORITY%",
      "dataType": "string",
      "description": "Priorytet (Priority)",
      "defaultValue": "100000"
    }
  },
  "SpecialCustomOperations": {
    "*": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "$if$" ],
            "endif": [ "$endif$" ]
          }
        }
      ]
    }
  },
  "sources": [
    {
      "include": [ "*.cs", "*.xml" ]
    }
  ]
}
