{
  "$schema": "http://json.schemastore.org/template",
  "author": "Soneta",
  "classifications": [ "Soneta", "Addon", "Item", "Worker" ],
  "identity": "Soneta.Addon.Item.Worker",
  "groupIdentity": "Soneta.Addon.Item.Worker",
  "name": "Soneta Addon Item Worker",
  "shortName": "soneta-item-worker",
  "description": "Komponent Worker dla produktów firmy Soneta",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "preferNameDirectory": false,

  "symbols": {
    "workername": {
      "type": "parameter",
      "dataType": "string",
      "description": "Własna nazwa klasy workera - wprowadzamy bez słowa worker"
    },
    "default-namespace": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "description": "Przestrzeń nazw dla workera",
      "msbuild": "RootNamespace",
      "replaces": "%NAMESPACE%"
    },
    "computed-name": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "workername",
        "fallbackVariableName": "default-namespace"
      }
    },
    "safe-computed-name": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "computed-name",
        "steps": [
          {
            "regex": "^(.*?)\\..*",
            "replacement": "$1"
          }
        ]
      }
    },
    "workerClassName": {
      "type": "generated",
      "generator": "join",
      "replaces": "%WORKERCLASSNAME%",
      "fileRename": "Class",
      "description": "Nazwa klasy workera",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "safe-computed-name"
          },
          {
            "type": "const",
            "value": "Worker"
          }
        ],
        "separator": "",
        "removeEmptyValues": true
      }
    },

    "worker-params": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": true,
      "description": "Generuj parametry workera"
    },
    "worker-params-caption": {
      "type": "parameter",
      "replaces": "%WORKERPARAMSCAPTION%",
      "dataType": "string",
      "defaultValue": "MyWorker with Params",
      "description": "Tytuł okna parametrów (CaptionHtml)"
    },
    "worker-datatype": {
      "type": "parameter",
      "replaces": "%WORKERDATATYPE%",
      "dataType": "string",
      "defaultValue": "Soneta.Towary.Towar",
      "description": "Typ danych (DataType) np. Soneta.Zadania.Zadanie , Soneta.CRM.Kontrahent"
    },
    "worker-priority": {
      "type": "parameter",
      "replaces": "%WORKERPRORITY%",
      "dataType": "string",
      "description": "Priorytet (Priority)",
      "defaultValue": "100000"
    }
  },
  "sources": [
    {
      "include": "*.cs"
    },
    {
      "include": "*.xml",
      "condition": "worker-params"
    }
  ],
  "SpecialCustomOperations": {
    "*": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "$if$" ],
            "endif": [ "$endif$" ]
          }
        }
      ]
    }
  }
}
